enum TaskStatus {
  OPEN
  RESOLVED
  WONT_FIX
  INVALID
  SPITE
}

enum TaskPriority {
  UNBREAK_NOW
  NEEDS_TRIAGE
  HIGH
  NORMAL
  LOW
  WISHLIST
}

enum TaskVisibility {
  ALL_USERS
  CUSTOM
}

enum TaskActivityType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TAG_ADDED
  TAG_REMOVED
  SUBSCRIBER_ADDED
  SUBSCRIBER_REMOVED
  COMMENT_ADDED
}

enum UserRole {
  ADMIN
  USER
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id            Int              @id @default(autoincrement())
  username      String           @unique
  email         String           @unique
  displayName   String
  avatarUrl     String?
  role          UserRole         @default(USER)
  passwordHash  String?
  createdAt     DateTime
  updatedAt     DateTime

  createdTasks  Task[]           @relation("TaskAuthor")
  assignedTasks Task[]           @relation("TaskAssignee")
  comments      TaskComment[]
  activities    TaskActivity[]
  subscriptions TaskSubscriber[]
  repositories  Repository[]
  gitAccessTokens GitAccessToken[]
}

model Repository {
  id          Int                  @id @default(autoincrement())
  name        String
  slug        String               @unique
  description String?
  localPath   String
  visibility  RepositoryVisibility @default(PRIVATE)
  createdById Int
  createdAt   DateTime
  updatedAt   DateTime

  createdBy   User                 @relation(fields: [createdById], references: [id])
}


model GitAccessToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  tokenHash String   @unique
  createdAt DateTime
  expiresAt DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Task {
  id           Int              @id @default(autoincrement())
  taskNumber   Int              @unique
  title        String
  description  String?

  status       TaskStatus       @default(OPEN)
  priority     TaskPriority     @default(NORMAL)
  visibility   TaskVisibility   @default(ALL_USERS)

  createdById  Int
  assignedToId Int?
  parentTaskId Int?

  createdAt    DateTime
  updatedAt    DateTime

  createdBy    User             @relation("TaskAuthor", fields: [createdById], references: [id])
  assignedTo   User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])

  parentTask   Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks     Task[]           @relation("TaskHierarchy")

  comments     TaskComment[]
  activities   TaskActivity[]
  subscribers  TaskSubscriber[]
  tags         TaskTag[]
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String
  createdAt DateTime
  updatedAt DateTime

  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model TaskActivity {
  id        Int              @id @default(autoincrement())
  taskId    Int
  userId    Int
  type      TaskActivityType
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime

  task      Task             @relation(fields: [taskId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model TaskSubscriber {
  taskId    Int
  userId    Int
  createdAt DateTime

  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime
  updatedAt   DateTime

  tasks       TaskTag[]
}

model TaskTag {
  taskId Int
  tagId  Int

  task   Task @relation(fields: [taskId], references: [id])
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@id([taskId, tagId])
}
